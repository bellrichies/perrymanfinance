{
    "name": "perrymanfinance/backend",
    "description": "PerrymanFinance REST API",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "PerrymanFinance\\": "app/"
        },
        "classmap": [
            "database/seeders/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=phpcs.xml",
        "cs:fix": "phpcbf --standard=phpcs.xml",
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "lint": [
            "@cs",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
