<?xml version="1.0"?>
<ruleset name="PerrymanFinance">
    <description>PerrymanFinance PSR-12 coding standard.</description>
    <file>app</file>
    <file>bin</file>
    <file>public</file>
    <file>tests</file>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength.TooLong">
        <severity>0</severity>
    </rule>
</ruleset>
